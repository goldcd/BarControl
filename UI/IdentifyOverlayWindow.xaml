<Window x:Class="BarControl.UI.IdentifyOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Identify Display"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Grid>
        <!-- Center Overlay Card -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#EE18181B"
                BorderBrush="{Binding CardBorderBrush}"
                BorderThickness="2"
                CornerRadius="20"
                Padding="40,32"
                MinWidth="380"
                Effect="{DynamicResource CardShadow}">
            <Border.Triggers>
                <EventTrigger RoutedEvent="Border.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.0" To="1.0" Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <StackPanel HorizontalAlignment="Center">
                <!-- Monitor Number Circle -->
                <Border Width="90" Height="90"
                        CornerRadius="45"
                        Background="{Binding AccentBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <TextBlock Text="{Binding IndexNumber}"
                               FontSize="52"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Monitor Name -->
                <TextBlock Text="{Binding DisplayTitle}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,8" />

                <!-- Resolution & Scaling -->
                <TextBlock Text="{Binding ResolutionInfo}"
                           FontSize="15"
                           Foreground="#A1A1AA"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />

                <!-- Status Badge -->
                <Border Background="{Binding StatusBgBrush}"
                        CornerRadius="12"
                        Padding="14,6"
                        HorizontalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="White" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          Color="Black"
                          BlurRadius="40"
                          ShadowDepth="6"
                          Opacity="0.75" />
    </Window.Resources>
</Window>
