<Window x:Class="BarControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:BarControl.UI"
        mc:Ignorable="d"
        Title="BarControl - Soundbar &amp; HDMI-CEC Control"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="845" Width="680"
        MinHeight="770" MinWidth="580"
        WindowStartupLocation="CenterScreen"
        Background="#161618"
        Foreground="#EDEDED"
        FontFamily="Segoe UI, Inter, Roboto, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Windows 11 Fluent Button Styles -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#383840"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#32323A"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4C4C58"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1C1C20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Fluent ComboBox Item Style -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="4"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#32323A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Fluent ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#383842"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#222226"
                                                BorderBrush="#383842"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#A1A1AA"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#2A2A30"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#4C4C58"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#0078D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,3,28,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#222226"
                                            BorderBrush="#383842"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,4,0,4"
                                            Padding="4">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Custom Fluent Volume Slider Style -->
        <Style x:Key="FluentVolumeSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="18"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="18"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="16" Height="16">
                                                    <Ellipse Width="14" Height="14" Fill="#34D399" Stroke="#FFFFFF" StrokeThickness="1.75"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Soundbar Device Selection -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Scrollable Features List -->
            <RowDefinition Height="*"/>
            <!-- 3: Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 0: HEADER BAR ================= -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,10" BorderBrush="#25252A" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox Content="Start with Windows"
                          IsChecked="{Binding StartWithWindows}"
                          Foreground="#9E9EA6"
                          FontSize="11.5"
                          Margin="0,0,14,0"
                          VerticalAlignment="Center"
                          Cursor="Hand"/>

                <CheckBox Content="Start Minimized"
                          IsChecked="{Binding StartMinimized}"
                          Foreground="#9E9EA6"
                          FontSize="11.5"
                          VerticalAlignment="Center"
                          Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- ================= 1: SOUNDBAR SELECTION & DISPLAY/AUDIO GUARDING ================= -->
        <Border Grid.Row="1"
                Background="#1E1E22"
                BorderBrush="#2C2C32"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="SELECT SOUNDBAR / HDMI AUDIO DEVICE"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#8E8E98"
                           Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Displays}"
                              SelectedItem="{Binding SelectedSoundbar, Mode=TwoWay}"
                              Style="{StaticResource DarkComboBoxStyle}"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayTitle}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Padding="4,2"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="1"
                            Content="Rescan"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="10,0,0,0"
                            Padding="12,7"
                            Click="OnRefreshClicked"
                            ToolTip="Rescan connected HDMI displays and audio endpoints"/>
                </Grid>

                <!-- Option 1: Phantom Display Guard (scoped to selected device; disabled if primary monitor is selected) -->
                <Border Background="#25252A"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,0,0,8"
                        ToolTip="{Binding PhantomDisplayGuardToolTip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Phantom Display Guard" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Prevent windows and cursors from getting lost on this soundbar display (audio continues)."
                                       FontSize="11" Foreground="#9E9EA6" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding IsPhantomDisplayGuardEnabled}"
                                  IsEnabled="{Binding CanEnablePhantomDisplayGuard}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Option 2: Continuous Audio Keep-Alive (scoped to selected device) -->
                <Border Background="#25252A" CornerRadius="6" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Continuous Audio Keep-Alive" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Streams an inaudible signal to prevent soundbar sleep and audio cut-off/clipping."
                                       FontSize="11" Foreground="#9E9EA6" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding IsAudioKeepAliveEnabled}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ================= 2: SOUNDBAR FEATURES LIST ================= -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel>
                <!-- FEATURE CARD 1: HDMI-CEC POWER MANAGEMENT -->
                <Border Background="#1E1E22"
                        BorderBrush="#2C2C32"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Card Header -->
                        <TextBlock Text="HDMI-CEC Power Management"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,10"/>

                        <!-- Hardware / Connection Details Bar with Interactive Volume Slider -->
                        <Border Background="#17171A" CornerRadius="6" Padding="12,9" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Adapter:" FontSize="11.5" Foreground="#71717A" Margin="0,0,4,0"/>
                                        <TextBlock Text="Pulse-Eight USB-CEC" FontSize="11.5" FontWeight="SemiBold" Foreground="#EDEDED" Margin="0,0,6,0"/>
                                        <TextBlock Text="(" FontSize="11.5" Foreground="#71717A"/>
                                        <TextBlock Text="{Binding CecPortName}" FontSize="11.5" Foreground="#A1A1AA"/>
                                        <TextBlock Text=")" FontSize="11.5" Foreground="#71717A" Margin="0,0,10,0"/>

                                        <TextBlock Text="• Device:" FontSize="11.5" Foreground="#71717A" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding SoundbarVendor}" FontSize="11.5" Foreground="#A1A1AA" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding SoundbarCecName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#EDEDED"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CecVolumeText}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding CecVolumeForeground}"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Interactive Volume Slider Bar (Dual-Indicator: Requested Thumb + Chasing Actual Fill & Line) -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="🔉"
                                            IsEnabled="{Binding CanControlVolume}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Padding="6,1"
                                            FontSize="10"
                                            Height="24"
                                            Margin="0,0,8,0"
                                            Click="OnVolumeDownClicked"
                                            ToolTip="Step volume down"/>

                                    <Grid Grid.Column="1" VerticalAlignment="Center" Height="24">
                                        <!-- Visual Track Container (inset by 8px on left/right so 0..100% aligns with the 16px Thumb center) -->
                                        <Grid x:Name="VolumeTrackVisualHost" Margin="8,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <!-- 1. Base Unfilled Track -->
                                            <Border Background="#2C2C34" Height="5" CornerRadius="2.5" VerticalAlignment="Center"/>

                                            <!-- 2. Requested Volume Ghost Bar (shows target while chasing upward) -->
                                            <Border Background="#1D4E40"
                                                    Height="5"
                                                    CornerRadius="2.5"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <Border.Width>
                                                    <MultiBinding Converter="{x:Static ui:PercentageToWidthConverter.Instance}">
                                                        <Binding Path="CecVolumeSliderValue"/>
                                                        <Binding ElementName="VolumeTrackVisualHost" Path="ActualWidth"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>

                                            <!-- 3. Actual Hardware Volume Fill Bar -->
                                            <Border Background="#34D399"
                                                    Height="5"
                                                    CornerRadius="2.5"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <Border.Width>
                                                    <MultiBinding Converter="{x:Static ui:PercentageToWidthConverter.Instance}">
                                                        <Binding Path="CecActualVolumePercent"/>
                                                        <Binding ElementName="VolumeTrackVisualHost" Path="ActualWidth"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>

                                            <!-- 4. Chasing Actual Volume Tick Line (illuminates where the speaker currently is while chasing) -->
                                            <Border Width="3"
                                                    Height="13"
                                                    CornerRadius="1.5"
                                                    Background="#FBBF24"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsVolumeChasing, Converter={x:Static ui:BooleanToVisibilityConverter.Instance}}">
                                                <Border.Margin>
                                                    <MultiBinding Converter="{x:Static ui:PercentageToMarkerMarginConverter.Instance}">
                                                        <Binding Path="CecActualVolumePercent"/>
                                                        <Binding ElementName="VolumeTrackVisualHost" Path="ActualWidth"/>
                                                    </MultiBinding>
                                                </Border.Margin>
                                            </Border>
                                        </Grid>

                                        <!-- Interactive Slider (Thumb = Requested Volume) -->
                                        <Slider Minimum="0"
                                                Maximum="100"
                                                SmallChange="1"
                                                LargeChange="5"
                                                Value="{Binding CecVolumeSliderValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding CanControlVolume}"
                                                Style="{StaticResource FluentVolumeSliderStyle}"
                                                Thumb.DragStarted="OnVolumeSliderThumbDragStarted"
                                                Thumb.DragCompleted="OnVolumeSliderThumbDragCompleted"
                                                PreviewMouseLeftButtonDown="OnVolumeSliderMouseDown"
                                                PreviewMouseLeftButtonUp="OnVolumeSliderMouseUp"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                ToolTip="Drag or click anywhere on the bar to set target volume — the amber marker &amp; green bar show actual speaker volume chasing your target"/>
                                    </Grid>

                                    <Button Grid.Column="2"
                                            Content="🔊"
                                            IsEnabled="{Binding CanControlVolume}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Padding="6,1"
                                            FontSize="10"
                                            Height="24"
                                            Margin="8,0,0,0"
                                            Click="OnVolumeUpClicked"
                                            ToolTip="Step volume up"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Checkbox Option 1: Standby & Wake Sync -->
                        <Border Background="#25252A" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Auto-Power Sync (Sleep / Wake / Shutdown)" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Turn soundbar off when PC sleeps or shuts down, and wake it when PC resumes from sleep."
                                               FontSize="11" Foreground="#9E9EA6" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsPowerSyncEnabled}"
                                          VerticalAlignment="Center"
                                          Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- Checkbox Option 2: Wake on PC Boot / App Startup -->
                        <Border Background="#25252A" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Turn Soundbar On with PC Boot" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Automatically wake the soundbar when your PC boots up and BarControl starts."
                                               FontSize="11" Foreground="#9E9EA6" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsWakeOnStartupEnabled}"
                                          VerticalAlignment="Center"
                                          Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- Manual Power Toggle Button -->
                        <Button Content="{Binding PowerToggleButtonText}"
                                Background="{Binding PowerToggleButtonBackground}"
                                BorderBrush="{Binding PowerToggleButtonBorderBrush}"
                                Foreground="{Binding PowerToggleButtonForeground}"
                                IsEnabled="{Binding CanTogglePower}"
                                Style="{StaticResource ActionButtonStyle}"
                                Height="36"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="OnTogglePowerClicked"
                                ToolTip="Toggle soundbar power state via HDMI-CEC"/>
                    </StackPanel>
                </Border>

                <!-- FEATURE CARD 2: DOLBY ATMOS / BITSTREAM CEC VOLUME PROXY -->
                <Border Background="#1E1E22"
                        BorderBrush="{Binding BitstreamProxyCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <StackPanel>
                        <!-- Card Header + Live Status Badge -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Dolby Atmos / Bitstream Volume Proxy"
                                       FontSize="14.5"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <Border Grid.Column="1"
                                    Background="{Binding BitstreamProxyBadgeBackground}"
                                    BorderBrush="{Binding BitstreamProxyBadgeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="9,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding BitstreamProxyStatusText}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{Binding BitstreamProxyBadgeForeground}"/>
                            </Border>
                        </Grid>

                        <!-- Toggle Row -->
                        <Border Background="#25252A" CornerRadius="6" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Seamless Keyboard Volume Bridge &amp; Auto-Restore" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="{Binding BitstreamProxySubtitleText}"
                                               FontSize="11" Foreground="#9E9EA6" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsBitstreamProxyEnabled}"
                                          VerticalAlignment="Center"
                                          Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= 3: FOOTER BAR ================= -->
        <Border Grid.Row="3" Padding="0,8,0,0" BorderBrush="#25252A" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Version & Update Notification -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BarControl " FontSize="11" Foreground="#71717A" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" ToolTip="Current running version"/>

                    <!-- Update notification & one-click action (only visible if a newer GitHub release is available) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                Visibility="{Binding IsUpdateAvailable, Converter={x:Static ui:BooleanToVisibilityConverter.Instance}}">
                        <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="UPDATE" FontSize="9.5" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                        <TextBlock Text="New version available: " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AvailableUpdateVersion}" FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <Button Content="{Binding UpdateButtonText}"
                                Click="OnApplyUpdateClicked"
                                IsEnabled="{Binding IsDownloadingUpdate, Converter={x:Static ui:InverseBooleanConverter.Instance}}"
                                Background="#2563EB" Foreground="White" BorderThickness="0"
                                Padding="10,3" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Sweep button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Sweep Windows"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OnSweepClicked"
                            Padding="10,4"
                            FontSize="11.5"
                            ToolTip="Instantly pull any off-limits window back to primary monitor"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
