<Window x:Class="BarControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:BarControl.UI"
        mc:Ignorable="d"
        Title="BarControl - Soundbar &amp; HDMI-CEC Control"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="630" Width="680"
        MinHeight="540" MinWidth="580"
        WindowStartupLocation="CenterScreen"
        Background="#161618"
        Foreground="#EDEDED"
        FontFamily="Segoe UI, Inter, Roboto, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Windows 11 Fluent Button Styles -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#383840"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#32323A"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4C4C58"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1C1C20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#1A88E0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1084D9"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#2B95E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AmberButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#3B2E15"/>
            <Setter Property="BorderBrush" Value="#665022"/>
            <Setter Property="Foreground" Value="#FBBF24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#523E1A"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#806328"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Fluent ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#383840"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Soundbar Device Selection -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Scrollable Features List -->
            <RowDefinition Height="*"/>
            <!-- 3: Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 0: HEADER BAR ================= -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#25252A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Icon & Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icon -->
                    <Border Width="26" Height="26" Margin="0,0,10,0" Background="#0078D4" CornerRadius="6" VerticalAlignment="Center">
                        <TextBlock Text="🔊" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="BarControl" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="— Soundbar &amp; CEC" FontSize="13" FontWeight="SemiBold" Foreground="#8E8E98" VerticalAlignment="Center" Margin="6,2,0,0"/>
                    </StackPanel>

                    <!-- Guard Status Button -->
                    <Button Click="OnToggleGuardClicked"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            ToolTip="Click to toggle BarControl Guard On/Off">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="pillBorder"
                                        Background="{Binding StatusBrush, FallbackValue=#164E3D}"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="White" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusText, FallbackValue='GUARD ACTIVE'}"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="pillBorder" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Right: Options -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox Content="Start with Windows"
                              IsChecked="{Binding StartWithWindows}"
                              Foreground="#9E9EA6"
                              FontSize="11.5"
                              Margin="0,0,14,0"
                              VerticalAlignment="Center"
                              Cursor="Hand"/>

                    <CheckBox Content="Start Minimized"
                              IsChecked="{Binding StartMinimized}"
                              Foreground="#9E9EA6"
                              FontSize="11.5"
                              VerticalAlignment="Center"
                              Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 1: SOUNDBAR SELECTION DROPDOWN ================= -->
        <Border Grid.Row="1"
                Background="#1E1E22"
                BorderBrush="#2C2C32"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="SELECT SOUNDBAR / HDMI AUDIO DEVICE"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#8E8E98"
                           Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Displays}"
                              SelectedItem="{Binding SelectedSoundbar, Mode=TwoWay}"
                              Style="{StaticResource DarkComboBoxStyle}"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,3">
                                    <TextBlock Text="🔊" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                            <TextBlock Text=" (Soundbar)" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" Margin="6,1,0,0"
                                                       Visibility="{Binding HasAudioEndpoint, Converter={x:Static ui:BooleanToVisibilityConverter.Instance}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#8E8E98"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="1"
                            Content="🔄 Rescan"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="10,0,0,0"
                            Padding="12,7"
                            Click="OnRefreshClicked"
                            ToolTip="Rescan connected HDMI displays and audio endpoints"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= 2: SOUNDBAR FEATURES LIST ================= -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel>
                <!-- FEATURE CARD 1: HDMI-CEC POWER MANAGEMENT -->
                <Border Background="#1E1E22"
                        BorderBrush="#2C2C32"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="HDMI-CEC Power Management" FontSize="14.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Live Power Status Badge -->
                            <Border Grid.Column="1"
                                    Background="{Binding CecPowerStatusBrush}"
                                    CornerRadius="10"
                                    Padding="10,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding CecPowerStatusText}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </Grid>

                        <!-- Hardware / Connection Details Bar -->
                        <Border Background="#17171A" CornerRadius="6" Padding="12,7" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Adapter:" FontSize="11.5" Foreground="#71717A" Margin="0,0,4,0"/>
                                    <TextBlock Text="Pulse-Eight USB-CEC" FontSize="11.5" FontWeight="SemiBold" Foreground="#EDEDED" Margin="0,0,6,0"/>
                                    <TextBlock Text="(" FontSize="11.5" Foreground="#71717A"/>
                                    <TextBlock Text="{Binding CecPortName}" FontSize="11.5" Foreground="#A1A1AA"/>
                                    <TextBlock Text=")" FontSize="11.5" Foreground="#71717A" Margin="0,0,10,0"/>

                                    <TextBlock Text="• Device:" FontSize="11.5" Foreground="#71717A" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding SoundbarVendor}" FontSize="11.5" Foreground="#A1A1AA" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding SoundbarCecName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#EDEDED"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding CecVolumeText}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#34D399"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Checkbox Option 1: Standby & Wake Sync -->
                        <Border Background="#25252A" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Auto-Power Sync (Sleep / Wake)" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Turn soundbar off when PC enters standby, and wake it up when PC wakes up."
                                               FontSize="11" Foreground="#9E9EA6" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsPowerSyncEnabled}"
                                          VerticalAlignment="Center"
                                          Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- Manual Power Control Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="⚡ Power On"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnPowerOnClicked"
                                    ToolTip="Send CEC power on sequence to soundbar now"/>

                            <Button Grid.Column="2"
                                    Content="🌙 Standby (Off)"
                                    Style="{StaticResource AmberButtonStyle}"
                                    Click="OnStandbyClicked"
                                    ToolTip="Send CEC standby command to soundbar now"/>

                            <Button Grid.Column="4"
                                    Content="🔄 Refresh Status"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="OnRefreshCecClicked"
                                    ToolTip="Poll soundbar power and volume status over CEC"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- FEATURE CARD 2: PHANTOM DISPLAY GUARD & AUDIO KEEP-ALIVE -->
                <Border Background="#1E1E22"
                        BorderBrush="#2C2C32"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🛡 Audio &amp; Phantom Display Guarding" FontSize="14.5" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                        <!-- Option: Phantom Display Guard -->
                        <Border Background="#25252A" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Phantom Display Guard" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Prevent windows and cursors from getting lost on this soundbar display (audio continues)."
                                               FontSize="11" Foreground="#9E9EA6" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsPhantomDisplayGuardEnabled}"
                                          VerticalAlignment="Center"
                                          Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- Option: Audio Keep-Alive -->
                        <Border Background="#25252A" CornerRadius="6" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Continuous Audio Keep-Alive" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Streams an inaudible signal to prevent soundbar sleep and audio cut-off/clipping."
                                               FontSize="11" Foreground="#9E9EA6" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsAudioKeepAliveEnabled}"
                                          VerticalAlignment="Center"
                                          Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- FEATURE CARD 3: DOLBY ATMOS & BITSTREAM VOLUME BRIDGE PREVIEW -->
                <Border Background="#1A1A1E"
                        BorderBrush="#26262B"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎵" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dolby Atmos / Bitstream CEC Volume Proxy" FontSize="13" FontWeight="SemiBold" Foreground="#D4D4D8"/>
                            </StackPanel>
                            <TextBlock Text="Proxies Windows volume controls via HDMI-CEC when streaming Atmos or DTS direct audio."
                                       FontSize="11" Foreground="#71717A" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#2A2A30"
                                CornerRadius="5"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="Next Feature" FontSize="10" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= 3: FOOTER BAR ================= -->
        <Border Grid.Row="3" Padding="0,8,0,0" BorderBrush="#25252A" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Version & Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BarControl " FontSize="11" Foreground="#71717A"/>
                    <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="#A1A1AA"/>
                    <TextBlock Text=" • Pulse-Eight HDMI-CEC Ready" FontSize="11" Foreground="#52525B" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Right: Sweep button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚡ Sweep Windows"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OnSweepClicked"
                            Padding="10,4"
                            FontSize="11.5"
                            ToolTip="Instantly pull any off-limits window back to primary monitor"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
